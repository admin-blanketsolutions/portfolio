# Login role that is a MEMBER of audit_app (NOBYPASSRLS, not the table owner).
DATABASE_URL=postgresql://audit_app_login@db.internal:5432/audit
DB_POOL_MAX=20
DB_STATEMENT_TIMEOUT_MS=15000
# Must match a row in sec.context_signing_keys (status 'active'). Inject from the
# secrets manager at runtime; never commit. Use "base64:<32+ random bytes>".
CTX_SIGNING_KEY_ID=prod-2026-09
CTX_SIGNING_KEY=base64:REPLACE_ME
CTX_TTL_SECONDS=60
# Separate key for background-job envelopes (queue payload integrity).
JOB_ENVELOPE_KEY=base64:REPLACE_ME
OIDC_AUDIENCE=audit-platform-api
# Tenants are addressed as <slug>.<TENANT_BASE_DOMAIN>
TENANT_BASE_DOMAIN=app.example.com
# Requests for tenants homed in another region are refused (data residency).
DEPLOYMENT_REGION=me-central-1
PORT=3000

# --- TB ingestion (Phase 3) ---
TB_UPLOAD_MAX_BYTES=26214400
# Sandboxed parser package and interpreter (defaults: ../parser and its .venv)
TB_PARSER_DIR=../parser
# TB_PARSER_PYTHON=/opt/tb-parser/.venv/bin/python
TB_PARSER_TIMEOUT_MS=90000
# Only 'memory' exists today (dev/test). The S3 + Object Lock adapter ships with the infrastructure code.
OBJECT_STORE_DRIVER=memory
TB_SOURCE_BUCKET=audit-tb-sources
# LLM stage of the mapping cascade: off by default. Each tenant must ALSO be
# opted in by the control plane (platform.set_llm_mapping_allowed) after its
# data-transfer assessment. Credentials: ANTHROPIC_API_KEY from the secrets manager.
MAPPING_LLM_ENABLED=false
MAPPING_LLM_MODEL=claude-opus-5
MAPPING_LLM_EFFORT=medium
MAPPING_LLM_BATCH_SIZE=50
