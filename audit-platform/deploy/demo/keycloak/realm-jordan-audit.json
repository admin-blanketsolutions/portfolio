      "email": "yousef.ali@jordan-audit.example",
      "emailVerified": true,
      "enabled": true,
      "credentials": [
        {
          "type": "password",
          "value": "${DEMO_PASSWORD_JUNIOR}",
          "temporary": false
        }
      ]
    }
  ]
}